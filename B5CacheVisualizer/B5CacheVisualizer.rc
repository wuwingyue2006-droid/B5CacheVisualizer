#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_B5CACHEVISUALIZER_DIALOG DIALOGEX 0, 0, 1110, 760
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "B5 Multi-level Cache Visualizer"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    GROUPBOX        "L1 Configuration",IDC_STATIC,12,12,250,130
    LTEXT           "Cache Size",IDC_STATIC,24,32,80,12
    EDITTEXT        IDC_EDIT_L1_SIZE,108,28,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Block Size",IDC_STATIC,24,58,80,12
    EDITTEXT        IDC_EDIT_L1_BLOCK,108,54,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Associativity",IDC_STATIC,24,84,80,12
    EDITTEXT        IDC_EDIT_L1_ASSOC,108,80,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Mapping",IDC_STATIC,24,110,80,12
    COMBOBOX        IDC_COMBO_L1_MAPPING,108,106,120,80,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Replacement",IDC_STATIC,24,136,80,12
    COMBOBOX        IDC_COMBO_L1_REPLACEMENT,108,132,120,80,CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX        "L2 Configuration",IDC_STATIC,12,152,250,130
    LTEXT           "Cache Size",IDC_STATIC,24,172,80,12
    EDITTEXT        IDC_EDIT_L2_SIZE,108,168,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Block Size",IDC_STATIC,24,198,80,12
    EDITTEXT        IDC_EDIT_L2_BLOCK,108,194,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Associativity",IDC_STATIC,24,224,80,12
    EDITTEXT        IDC_EDIT_L2_ASSOC,108,220,120,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Mapping",IDC_STATIC,24,250,80,12
    COMBOBOX        IDC_COMBO_L2_MAPPING,108,246,120,80,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Replacement",IDC_STATIC,24,276,80,12
    COMBOBOX        IDC_COMBO_L2_REPLACEMENT,108,272,120,80,CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX        "Trace",IDC_STATIC,280,12,500,220
    EDITTEXT        IDC_EDIT_TRACE,292,30,476,150,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Import File",IDC_BUTTON_IMPORT,292,188,90,24
    PUSHBUTTON      "Clear",IDC_BUTTON_CLEAR_TRACE,392,188,70,24
    LTEXT           "Current: 0 / 0",IDC_STATIC_TRACE_INDEX,470,194,120,12
    LTEXT           "Current request: none",IDC_STATIC_SUMMARY,600,194,150,12

    GROUPBOX        "Controls",IDC_STATIC,280,248,500,80
    PUSHBUTTON      "Apply Config",IDC_BUTTON_RUN,292,268,100,24
    PUSHBUTTON      "Step",IDC_BUTTON_STEP,404,268,80,24
    PUSHBUTTON      "Run All",IDC_BUTTON_RUN_ALL,496,268,90,24
    PUSHBUTTON      "Reset",IDC_BUTTON_RESET,598,268,80,24
    LTEXT           "Last Result: none",IDC_STATIC_LAST_RESULT,292,300,360,12

    GROUPBOX        "Statistics",IDC_STATIC,790,12,308,220
    EDITTEXT        IDC_EDIT_RESULT,802,30,284,180,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    GROUPBOX        "L1 Cache",IDC_STATIC,12,338,520,180
    CONTROL         "",IDC_L1_CACHE_VIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER,24,358,500,146

    GROUPBOX        "L2 Cache",IDC_STATIC,12,528,520,180
    CONTROL         "",IDC_L2_CACHE_VIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER,24,548,500,146
END
