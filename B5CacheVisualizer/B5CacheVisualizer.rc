#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_B5CACHEVISUALIZER_DIALOG DIALOGEX 0, 0, 700, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "B5 Multi-level Cache Visualizer"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    GROUPBOX        "L1 Configuration",IDC_STATIC,8,8,220,130
    LTEXT           "Cache Size",IDC_STATIC,16,27,78,10
    EDITTEXT        IDC_EDIT_L1_SIZE,100,23,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Block Size",IDC_STATIC,16,49,78,10
    EDITTEXT        IDC_EDIT_L1_BLOCK,100,45,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Associativity",IDC_STATIC,16,71,78,10
    EDITTEXT        IDC_EDIT_L1_ASSOC,100,67,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Mapping",IDC_STATIC,16,93,78,10
    COMBOBOX        IDC_COMBO_L1_MAPPING,100,89,118,70,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Replacement",IDC_STATIC,16,115,78,10
    COMBOBOX        IDC_COMBO_L1_REPLACEMENT,100,111,118,70,CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX        "L2 Configuration",IDC_STATIC,236,8,220,130
    LTEXT           "Cache Size",IDC_STATIC,244,27,78,10
    EDITTEXT        IDC_EDIT_L2_SIZE,328,23,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Block Size",IDC_STATIC,244,49,78,10
    EDITTEXT        IDC_EDIT_L2_BLOCK,328,45,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Associativity",IDC_STATIC,244,71,78,10
    EDITTEXT        IDC_EDIT_L2_ASSOC,328,67,118,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Mapping",IDC_STATIC,244,93,78,10
    COMBOBOX        IDC_COMBO_L2_MAPPING,328,89,118,70,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Replacement",IDC_STATIC,244,115,78,10
    COMBOBOX        IDC_COMBO_L2_REPLACEMENT,328,111,118,70,CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX        "Trace",IDC_STATIC,8,145,448,88
    EDITTEXT        IDC_EDIT_TRACE,18,160,245,42,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Import File",IDC_BUTTON_IMPORT,18,207,55,20
    PUSHBUTTON      "Clear",IDC_BUTTON_CLEAR_TRACE,78,207,38,20
    PUSHBUTTON      "Trace Generator...",IDC_BUTTON_GENERATE_TRACE,121,207,70,20
    PUSHBUTTON      "Compare...",IDC_BUTTON_COMPARE,194,207,64,20
    LTEXT           "Stopped F0/0 D0/0",IDC_STATIC_TRACE_INDEX,196,211,67,10
    CONTROL         "Address Breakdown: no request",IDC_STATIC_ADDRESS_VIEW,"Static",SS_OWNERDRAW | WS_BORDER,270,160,176,67

    GROUPBOX        "Playback Controls",IDC_STATIC,464,145,228,92
    PUSHBUTTON      "Apply",IDC_BUTTON_RUN,474,160,47,17
    PUSHBUTTON      "Prev",IDC_BUTTON_PREVIOUS,524,160,31,17
    PUSHBUTTON      "Next",IDC_BUTTON_STEP,558,160,31,17
    PUSHBUTTON      "Run All",IDC_BUTTON_RUN_ALL,592,160,39,17
    PUSHBUTTON      "Reset",IDC_BUTTON_RESET,634,160,48,17
    PUSHBUTTON      "Auto",IDC_BUTTON_AUTOPLAY,474,181,38,17
    PUSHBUTTON      "Pause",IDC_BUTTON_PAUSE,515,181,40,17
    PUSHBUTTON      "Stop",IDC_BUTTON_STOP,558,181,36,17
    LTEXT           "Speed",IDC_STATIC,598,185,31,10
    COMBOBOX        IDC_COMBO_PLAYBACK_SPEED,632,181,50,60,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Access Path: no request",IDC_STATIC_ACCESS_PATH,"Static",SS_OWNERDRAW | WS_BORDER,474,201,208,26
    LTEXT           "Last: none",IDC_STATIC_LAST_RESULT,474,229,208,8

    GROUPBOX        "Statistics",IDC_STATIC,464,8,228,130
    EDITTEXT        IDC_EDIT_RESULT,474,23,91,103,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    CONTROL         "Outcome Mix",IDC_STATIC_OUTCOME_CHART,"Static",SS_OWNERDRAW | WS_BORDER,570,23,112,49
    CONTROL         "Cumulative Hit Rate",IDC_STATIC_RATE_CHART,"Static",SS_OWNERDRAW | WS_BORDER,570,77,112,49

    GROUPBOX        "L1 Cache",IDC_STATIC,8,240,338,112
    CONTROL         "",IDC_L1_CACHE_VIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER,18,257,318,85

    GROUPBOX        "L2 Cache",IDC_STATIC,354,240,338,112
    CONTROL         "",IDC_L2_CACHE_VIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER,364,257,318,85

END

IDD_COMPARISON_DIALOG DIALOGEX 0, 0, 610, 304
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cache Strategy Comparison"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    GROUPBOX        "Plans (2-3 independent simulators)",IDC_STATIC,8,8,274,184
    LISTBOX         IDC_LIST_COMPARE_PLANS,18,24,252,82,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Name",IDC_STATIC,18,116,28,10
    EDITTEXT        IDC_EDIT_COMPARE_NAME,50,112,136,16,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add current",IDC_BUTTON_COMPARE_ADD,192,111,76,18
    PUSHBUTTON      "Update current",IDC_BUTTON_COMPARE_UPDATE,18,139,84,18
    PUSHBUTTON      "Remove",IDC_BUTTON_COMPARE_REMOVE,108,139,56,18
    PUSHBUTTON      "Teaching presets",IDC_BUTTON_COMPARE_PRESETS,170,139,98,18
    LTEXT           "Edit a plan by loading it to the main window, changing L1/L2, then Update current.",IDC_STATIC,18,166,250,18

    GROUPBOX        "Same parsed Trace",IDC_STATIC,290,8,312,184
    LTEXT           "Current Trace will be used for all plans.",IDC_STATIC_COMPARE_TRACE,302,24,286,18
    PUSHBUTTON      "Use conflict-miss teaching trace",IDC_BUTTON_COMPARE_TEACHING,302,47,150,19
    PUSHBUTTON      "Run comparison",IDC_BUTTON_COMPARE_RUN,460,47,128,19
    EDITTEXT        IDC_EDIT_COMPARE_RESULTS,302,74,286,108,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    GROUPBOX        "Overall hit rate (green) vs miss rate (red)",IDC_STATIC,8,198,594,72
    CONTROL         "",IDC_STATIC_COMPARE_CHART,"Static",SS_OWNERDRAW | WS_BORDER,18,214,574,48
    PUSHBUTTON      "Load selected to main",IDC_BUTTON_COMPARE_LOAD,330,278,118,18
    DEFPUSHBUTTON   "Close",IDCANCEL,455,278,64,18
END

IDD_TRACE_GENERATOR_DIALOG DIALOGEX 0, 0, 660, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Locality Trace Generator"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "Mode",IDC_STATIC,10,15,28,10
    COMBOBOX        IDC_COMBO_GENERATOR_MODE,42,11,105,70,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Preset",IDC_STATIC,154,15,31,10
    COMBOBOX        IDC_COMBO_GENERATOR_PRESET,188,11,112,70,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Count",IDC_STATIC,307,15,30,10
    EDITTEXT        IDC_EDIT_GENERATOR_COUNT,340,11,42,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Start",IDC_STATIC,389,15,28,10
    EDITTEXT        IDC_EDIT_GENERATOR_START,420,11,55,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Range",IDC_STATIC,482,15,31,10
    EDITTEXT        IDC_EDIT_GENERATOR_RANGE,516,11,48,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Step",IDC_STATIC,571,15,25,10
    EDITTEXT        IDC_EDIT_GENERATOR_STEP,600,11,48,16,ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Loop",IDC_STATIC,10,44,25,10
    EDITTEXT        IDC_EDIT_GENERATOR_LOOP,38,40,40,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Hot count",IDC_STATIC,87,44,43,10
    EDITTEXT        IDC_EDIT_GENERATOR_HOT_COUNT,133,40,40,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Hot %",IDC_STATIC,182,44,29,10
    EDITTEXT        IDC_EDIT_GENERATOR_HOT_PERCENT,214,40,40,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Write %",IDC_STATIC,262,44,34,10
    EDITTEXT        IDC_EDIT_GENERATOR_WRITE_PERCENT,299,40,40,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Seed",IDC_STATIC,348,44,25,10
    EDITTEXT        IDC_EDIT_GENERATOR_SEED,376,40,70,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Range and step use bytes; percentages use 0-100.",IDC_STATIC,456,44,192,10

    LTEXT           "Disabled fields are ignored. The same parameters and seed reproduce the same trace.",IDC_STATIC,10,86,445,10
    DEFPUSHBUTTON   "Generate + Load",IDOK,482,80,90,20
    PUSHBUTTON      "Cancel",IDCANCEL,579,80,69,20
END
