#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_B5CACHEVISUALIZER_DIALOG DIALOGEX 0, 0, 520, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "B5 Multi-level Cache Visualizer - Framework"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "Memory Trace",IDC_STATIC,12,12,180,10
    EDITTEXT        IDC_EDIT_TRACE,12,26,238,236,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Run Trace",IDC_BUTTON_RUN,12,272,72,24
    PUSHBUTTON      "Reset",IDC_BUTTON_RESET,92,272,72,24
    LTEXT           "Current requests: 0",IDC_STATIC_SUMMARY,12,306,238,12
    LTEXT           "Simulation Summary",IDC_STATIC,270,12,180,10
    EDITTEXT        IDC_EDIT_RESULT,270,26,238,280,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END
